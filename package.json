{
  "name": "@rohal12/twee-ts",
  "version": "0.0.0-development",
  "description": "TypeScript Twee-to-HTML compiler — a complete reimplementation of Tweego",
  "type": "module",
  "license": "Unlicense",
  "publishConfig": {
    "access": "public"
  },
  "author": "Rohal12",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rohal12/twee-ts.git"
  },
  "homepage": "https://github.com/rohal12/twee-ts",
  "bugs": "https://github.com/rohal12/twee-ts/issues",
  "keywords": [
    "twine",
    "twee",
    "tweego",
    "sugarcube",
    "harlowe",
    "interactive-fiction",
    "story-format",
    "compiler"
  ],
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.cts",
  "typesVersions": {
    "*": {
      "vite": [
        "./dist/plugins/vite.d.cts"
      ],
      "rollup": [
        "./dist/plugins/rollup.d.cts"
      ]
    }
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./vite": {
      "import": {
        "types": "./dist/plugins/vite.d.ts",
        "default": "./dist/plugins/vite.js"
      },
      "require": {
        "types": "./dist/plugins/vite.d.cts",
        "default": "./dist/plugins/vite.cjs"
      }
    },
    "./rollup": {
      "import": {
        "types": "./dist/plugins/rollup.d.ts",
        "default": "./dist/plugins/rollup.js"
      },
      "require": {
        "types": "./dist/plugins/rollup.d.cts",
        "default": "./dist/plugins/rollup.cjs"
      }
    },
    "./schemas/*.json": "./schemas/*.json",
    "./package.json": "./package.json"
  },
  "bin": {
    "twee-ts": "./dist/bin/twee-ts.js"
  },
  "files": [
    "dist",
    "!dist/bin/*.d.ts",
    "schemas",
    "THIRD_PARTY_NOTICES",
    "UNLICENSE"
  ],
  "scripts": {
    "build": "tsdown",
    "check:package": "pnpm run build && node scripts/check-package.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:contracts": "pnpm run build && vitest run --config vitest.contracts.config.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "knip": "knip",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "duplication": "tsx scripts/duplication.ts",
    "release:gate": "tsx validation/release/release-gate.ts",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "mutation": "stryker run",
    "mutation:summary": "tsx scripts/mutation-summary.ts"
  },
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@stryker-mutator/core": "10.0.0",
    "@stryker-mutator/vitest-runner": "10.0.0",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.3",
    "@vitest/eslint-plugin": "^1.6.27",
    "acorn": "^8.19.0",
    "eslint": "^10.12.0",
    "fallow": "3.33.1",
    "fast-check": "^4.10.2",
    "jscpd": "5.4.1",
    "knip": "^6.41.0",
    "parse5": "^8.0.1",
    "playwright-core": "^1.64.0",
    "prettier": "^3.9.9",
    "rollup": "^4.64.4",
    "tsdown": "^0.23.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4",
    "vitepress": "^1.6.4",
    "vitest": "^5.0.3"
  },
  "peerDependencies": {
    "vite": ">=8"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  }
}
