{
  "name": "@rohal12/twee-ts",
  "version": "1.2.0",
  "description": "TypeScript Twee-to-HTML compiler — a complete reimplementation of Tweego",
  "type": "module",
  "license": "Unlicense",
  "publishConfig": {
    "access": "public"
  },
  "author": "Rohal12",
  "repository": {
    "type": "git",
    "url": "https://github.com/rohal12/twee-ts.git"
  },
  "homepage": "https://github.com/rohal12/twee-ts",
  "bugs": "https://github.com/rohal12/twee-ts/issues",
  "keywords": [
    "twine",
    "twee",
    "tweego",
    "sugarcube",
    "harlowe",
    "interactive-fiction",
    "story-format",
    "compiler"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./vite": {
      "types": "./dist/plugins/vite.d.ts",
      "import": "./dist/plugins/vite.js"
    },
    "./rollup": {
      "types": "./dist/plugins/rollup.d.ts",
      "import": "./dist/plugins/rollup.js"
    }
  },
  "bin": {
    "twee-ts": "./dist/bin/twee-ts.js"
  },
  "files": [
    "dist",
    "schemas"
  ],
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm run typecheck && pnpm test && pnpm run build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "duplication": "tsx scripts/duplication.ts",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "packageManager": "pnpm@10.14.0",
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@vitest/coverage-v8": "^5.0.2",
    "@vitest/eslint-plugin": "^1.6.27",
    "eslint": "^10.12.0",
    "fallow": "3.31.0",
    "fast-check": "^4.10.2",
    "htmlparser2": "^12.0.0",
    "jscpd": "5.4.0",
    "knip": "^6.39.0",
    "prettier": "^3.9.9",
    "rollup": "^4.64.0",
    "tsdown": "^0.23.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.1",
    "vitepress": "^1.6.4",
    "vitest": "^5.0.2"
  },
  "peerDependencies": {
    "vite": ">=5"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  },
  "pnpm": {
    "overrides": {
      "vitepress>vite": "^6.4.2"
    }
  }
}
